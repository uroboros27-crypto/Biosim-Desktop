{
  "name": "biosim",
  "version": "7.2.1",
  "description": "BioSim — Simulador bioclimatico autocontenido (escritorio)",
  "author": "Universidad de San Buenaventura - Pasto",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "42.4.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "co.edu.usb.biosim",
    "productName": "BioSim",
    "copyright": "Universidad de San Buenaventura - Pasto",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "BioSim*.html",
      "package.json"
    ],
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "BioSim-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "BioSim-${version}-setup.exe",
      "shortcutName": "BioSim"
    }
  }
}
